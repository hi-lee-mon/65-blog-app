{
  "name": "blog-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "panda codegen && lefthook install",
    "d": "next dev",
    "b": "bun run tc && next build",
    "s": "next start",
    "l": "oxlint && bun run lm",
    "lm": "markuplint \"app/**/*.tsx\" \"content/**/*.mdx\"",
    "tc": "panda codegen && next typegen && tsrs --noEmit",
    "f": "oxfmt",
    "fc": "oxfmt --check",
    "pg": "bun run panda codegen",
    "sb": "storybook dev -p 6006",
    "b:sb": "storybook build",
    "ay": "bun run b && playwright test"
  },
  "dependencies": {
    "@mdx-js/mdx": "3.1.1",
    "@shikijs/rehype": "4.5.0",
    "hast-util-to-string": "3.0.1",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rehype-slug": "6.0.0",
    "remark-gfm": "4.0.1",
    "valibot": "1.5.0",
    "vfile": "6.0.3",
    "vfile-matter": "5.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@markuplint/jsx-parser": "5.4.0",
    "@markuplint/mdx-parser": "5.4.0",
    "@markuplint/react-spec": "5.4.0",
    "@oxlint/plugins": "1.90.0",
    "@pandacss/dev": "2.5.0",
    "@pandacss/preset-base": "2.5.0",
    "@playwright/test": "1.65.0",
    "@socketsecurity/bun-security-scanner": "1.1.3",
    "@storybook/addon-a11y": "11.0.0-beta.1",
    "@storybook/addon-docs": "11.0.0-beta.1",
    "@storybook/nextjs-vite": "11.0.0-beta.1",
    "@types/hast": "3.0.5",
    "@types/node": "20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "lefthook": "2.2.2",
    "markuplint": "5.4.0",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "storybook": "11.0.0-beta.1",
    "tsrs": "0.20.1-ts7.1.0-beta",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "8.3.7"
  },
  "packageManager": "bun@1.4.4",
  "trustedDependencies": []
}
