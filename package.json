{
  "name": "blog-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prepare": "lefthook install",
    "dev": "next dev",
    "build": "bun run typecheck && next build",
    "start": "next start",
    "lint": "oxlint && markuplint \"app/**/*.tsx\" \"content/**/*.mdx\"",
    "typecheck": "next typegen && tsrs --noEmit",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "@mdx-js/mdx": "3.1.1",
    "@shikijs/rehype": "4.5.0",
    "next": "16.4.1",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "vfile": "6.0.3",
    "vfile-matter": "5.0.1"
  },
  "devDependencies": {
    "@markuplint/jsx-parser": "5.4.0",
    "@markuplint/mdx-parser": "5.4.0",
    "@markuplint/react-spec": "5.4.0",
    "@socketsecurity/bun-security-scanner": "1.1.3",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "lefthook": "2.2.2",
    "markuplint": "5.4.0",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "tailwindcss": "4.3.3",
    "tsrs": "0.20.1-ts7.1.0-beta",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "packageManager": "bun@1.4.4",
  "trustedDependencies": []
}
